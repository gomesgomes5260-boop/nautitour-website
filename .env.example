# Supabase (project: Nautitour BR, ref: hpinfkvfzezuizmeqsfm, sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — set in deployment env, never in client bundles
SUPABASE_SERVICE_ROLE_KEY=

# Pagar.me (server-only secrets)
# Mode: "off" = everyone sees "em breve"; "allowlist" = only emails listed
# below can pay; "live" = anyone can pay. Default: off.
PAGARME_MODE=off
PAGARME_ALLOWED_EMAILS=
PAGARME_API_KEY=
# Pagar.me v5 webhooks use HTTP Basic Auth — set both in the dashboard
# under the webhook's "Habilitar autenticação" toggle.
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=

# Pagar.me public key (safe to expose to the browser — used only to
# tokenize cards client-side so PAN/CVV never reach our servers).
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Optional: API base override (defaults to https://api.pagar.me/core/v5)
# PAGARME_API_URL=https://api.pagar.me/core/v5

# Resend (transactional e-mail).
# Get the API key at https://resend.com -> API Keys.
# Without RESEND_API_KEY the app skips sending and logs a warning; booking
# still confirms.
RESEND_API_KEY=
# Default sender. Use a Resend-verified address. While you haven't verified
# a custom domain, "Nautitour <onboarding@resend.dev>" works but can only
# deliver to addresses linked to your Resend account.
RESEND_SENDER=Nautitour <onboarding@resend.dev>

# Absolute site URL — used in e-mail templates (logo, CTA links).
# In Vercel production this is set to the canonical domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (captcha) — https://dash.cloudflare.com/?to=/:account/turnstile
# Em dev sem essas chaves, o widget é skipped (no-op).
# Pra preview/PR, use a "always-pass" key da Cloudflare: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limit) — OPCIONAL desde 18/jul: sem essas envs o rate
# limit roda no Postgres (RPC rate_limit_check, migration 034) via service
# role. Só volta pro Upstash se as duas estiverem setadas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Analytics 4 (G-…) — gateado por consent "analytics" do banner.
# Sem a env, GA é no-op.
NEXT_PUBLIC_GA_ID=

# Google Ads (AW-…) — tag de conversão/remarketing, gateada por consent
# "retargeting" (categoria Marketing do banner). Sem a env, no-op.
# O label vem da ação de conversão criada no painel do Ads (Ferramentas →
# Conversões → o trecho depois da barra em "send_to"). Com ambos setados,
# o evento purchase também dispara a conversão direta do Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Sentry (error tracking) — https://sentry.io
# Sem NEXT_PUBLIC_SENTRY_DSN, o Sentry vira no-op (nenhum evento enviado).
# Source map upload roda em build com SENTRY_AUTH_TOKEN; sem ele, build segue.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Vercel Cron (lembrete D-1 em /api/cron/reminders). O Vercel injeta esse
# Bearer automaticamente quando a env existe; sem ela a route responde 503.
CRON_SECRET=
